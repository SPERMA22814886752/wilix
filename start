#!/bin/bash

cd ~/Documents/initrd

gcc -static -O2 -o ~/wilix/initrd/sbin/init ~/wilix/oneinit/init.c

chmod +x ~/wilix/initrd/sbin/init

cat > init << 'EOF'
#!/bin/bash
exec /sbin/init
EOF

chmod +x init

# создаем директорию для init скриптов
mkdir -p etc/init.d

# создаем скрипт для getty
cat > etc/init.d/S01-getty << 'GETTY'
#!/bin/sh

case "$1" in
    start)
        echo "starting getty on virtual consoles..."

        # запускаем нормальный getty на tty 2-7
        # без всяких -n и -l, чтобы вызывался штатный /bin/login
        for tty in tty3 tty4 tty5 tty6 tty7 tty8; do
            if [ -c /dev/$tty ]; then
                /bin/busybox getty 38400 $tty &
            fi
        done
        ;;
    stop)
        echo "stopping getty..."
        killall busybox getty 2>/dev/null
        ;;
    restart)
        $0 stop
        sleep 1
        $0 start
        ;;
    *)
        echo "usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac
GETTY

chmod +x etc/init.d/S01-getty

cat > etc/init.d/S03-network << 'EOF'
#!/bin/sh

WPA_SUPPLICANT="/usr/bin/wpa_supplicant"
WPA_CLI="/usr/bin/wpa_cli"
WPA_PASS="/usr/bin/wpa_passphrase"
CONF="/etc/wpa_supplicant.conf"

is_virtual() {
    grep -qi "hypervisor\|kvm\|virtualbox\|xen" /proc/cpuinfo || [ -d /sys/hypervisor ]
}

choose_iface() {
    echo "select network type:"
    echo "  1) wifi (wlan0)"
    echo "  2) ethernet (eth0)"
    printf "Choice [1/2]: "
    read choice
    case "$choice" in
        1) setup_wifi ;;
        2) setup_wired ;;
        *) echo "invalid choice"; exit 1 ;;
    esac
}

setup_wifi() {
    printf "ssid: "
    read ssid
    printf "password: "
    read psk

    echo "ctrl_interface=DIR=/var/run/wpa_supplicant" > "$CONF"
    echo "update_config=1" >> "$CONF"
    $WPA_PASS "$ssid" "$psk" >> "$CONF"

    killall wpa_supplicant 2>/dev/null
    rm -f /var/run/wpa_supplicant/wlan0
    mkdir -p /var/run/wpa_supplicant

    ip link set wlan0 up
    sleep 2  
    $WPA_SUPPLICANT -B -i wlan0 -c "$CONF"

    # Ждём до 30 секунд
    i=0
        while [ $i -lt 15 ]; do
            STATUS=$($WPA_CLI -i wlan0 status 2>/dev/null | grep wpa_state)
        if [ "$STATUS" = "wpa_state=COMPLETED" ]; then
            echo "Associated!"
            udhcpc -i wlan0 -q
            return
        fi
        sleep 2
        i=$((i + 1))
    done
    echo "Wi-Fi: no association, skipping DHCP"
}

setup_wired() {
    ip link set eth0 up
    if is_virtual; then
        ip addr add 10.0.2.15/24 dev eth0
        ip route add default via 10.0.2.2
    else
        ip addr add 192.168.1.100/24 dev eth0
        ip route add default via 192.168.1.1
    fi
}

case "$1" in
    start)
        choose_iface
        echo "nameserver 8.8.8.8" > /etc/resolv.conf
        ;;
    stop)
        killall wpa_supplicant 2>/dev/null
        ip link set eth0 down 2>/dev/null
        ip link set wlan0 down 2>/dev/null
        ;;
    *)
        echo "Usage: $0 {start|stop}"
        exit 1
        ;;
esac
EOF

chmod +x etc/init.d/S03-network

# создаем пустую директорию для спермы228
touch etc/init.d/.keep

echo "building initrd image..."
find . -print0 | cpio --null -o -H newc | zstd -19 > ../wilixos-v0.8.img


echo "done! image created: wilixos-v0.8"
