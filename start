#!/bin/bash

cd ~/initrd

# создаем директорию для init скриптов
mkdir -p etc/init.d

# создаем скрипт для getty
cat > etc/init.d/S01-getty << 'GETTY'
#!/bin/sh

case "$1" in
    start)
        echo "starting getty on virtual consoles..."
        
        # запускаем нормальный getty на tty 2-7
        # без всяких -n и -l, чтобы вызывался штатный /bin/login
        for tty in tty2 tty3 tty4 tty5 tty6 tty7; do
            if [ -c /dev/$tty ]; then
                /bin/busybox getty 38400 $tty &
            fi
        done
        ;;
    stop)
        echo "stopping getty..."
        killall busybox getty 2>/dev/null
        ;;
    restart)
        $0 stop
        sleep 1
        $0 start
        ;;
    *)
        echo "usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac
GETTY

chmod +x etc/init.d/S01-getty

# создаем вспомогательный скрипт информацию о консолях
cat > etc/init.d/99-consoles << 'CONSOLES'
#!/bin/sh

case "$1" in
    start)
        echo ""
        echo "available consoles:"
        echo "  tty1 (Ctrl+Alt+F1) - getty active"
        echo "  tty2 (Ctrl+Alt+F2) - getty active"
        echo "  tty3 (Ctrl+Alt+F3) - getty active"
        echo "  tty4 (Ctrl+Alt+F4) - getty active"
        echo "  current console - bash shell"
        echo ""
        ;;
esac
CONSOLES

chmod +x etc/init.d/99-consoles

cat > etc/init.d/S03-network << 'EOF'
#!/bin/sh
confirm() {
printf "enable network? [y,n]: "
read answer
case "$answer" in
y|Y|yes|Yes|YES)
return 0
            ;;
*)
echo "operation cancelled."
exit 0
            ;;
esac
}

# определяем виртуалка ли это
is_virtual() {
    # проверяем наличие virtio, hyperv и т.д.
    if grep -qi "hypervisor\|kvm\|virtualbox\|xen" /proc/cpuinfo; then
        return 0
    fi
    if [ -d /sys/hypervisor ]; then
        return 0
    fi
    return 1
}

case "$1" in
start)
confirm
echo "starting network..."
if [ ! -d /sys/class/net/eth0 ]; then
echo "  eth0 not found, skipping..."
exit 0
fi

ip link set eth0 up

# определяем IP в зависимости от железа
if is_virtual; then
    echo "  virtual machine detected, using 10.x.x.x"
    ip addr add 10.0.2.15/24 dev eth0
    ip route add default via 10.0.2.2
else
    echo "  real hardware detected, using 192.168.x.x"
    ip addr add 192.168.1.100/24 dev eth0
    ip route add default via 192.168.1.1
fi

echo "nameserver 8.8.8.8" > /etc/resolv.conf
echo "nameserver 1.1.1.1" >> /etc/resolv.conf

IP=$(ip addr show eth0 | grep "inet " | awk '{print $2}' | cut -d/ -f1)
if [ -n "$IP" ]; then
    echo "  network ready! ip: $IP"
else
    echo "  failed to configure network"
fi
        ;;
stop)
confirm
echo "stopping network..."
killall udhcpc 2>/dev/null
ip link set eth0 down
        ;;
restart)
$0 stop
sleep 1
$0 start
        ;;
status)
if ip addr show eth0 | grep -q "inet "; then
    echo "Network is up:"
    ip addr show eth0 | grep "inet "
    ip route show | grep default
else
    echo "network is down"
fi
        ;;
*)
echo "usage: $0 {start|stop|restart|status}"
exit 1
        ;;
esac
EOF

chmod +x etc/init.d/S03-network

# создаем пустую директорию для спермы228
touch etc/init.d/.keep

echo "building initrd image with getty support..."
find . | cpio -o -H newc | gzip > ../wilixos-v0.1.img

echo "=========================================="
echo "done! image created: ../wilixos-v0.1.img"
echo ""
echo "features added:"
echo "  - getty running on tty1, tty2, tty3, tty4"
echo "  - switch consoles with Ctrl+Alt+F1..F4"
echo "  - auto-start init scripts from /etc/init.d/"
echo ""
echo "to test in QEMU:"
echo "qemu-system-x86_64 -kernel /boot/vmlinuz -initrd ../wilixos-v0.1.img -append \"root=/dev/ram0\""
echo "=========================================="
