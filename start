#!/bin/bash

cd ~/Documents/initrd
cat > init << 'EOF'                                              
#!/bin/bash

# функция для запуска всех скриптов в /etc/init.d/
run_init_scripts() {
    if [ -d /etc/init.d ]; then
        echo "running init scripts from /etc/init.d/..."
        
        # Сортируем скрипты для правильного порядка запуска (S00, S01, etc)
        for script in $(ls /etc/init.d/S* 2>/dev/null | sort); do
            if [ -x "$script" ]; then
                echo -n "starting: $(basename $script) "
                $script start
                echo "[OK]"
            fi
        done
        
        # запускаем остальные скрипты
        for script in $(ls /etc/init.d/* 2>/dev/null | grep -v '/S' | sort); do
            if [ -x "$script" ]; then
                echo -n "running: $(basename $script) "
                $script
                echo "[OK]"
            fi
        done
    else
        echo "warning: /etc/init.d/ directory not found"
    fi
}

# монтируем файловые системы
/bin/busybox mount -t proc none /proc
/bin/busybox mount -t sysfs none /sys
/bin/busybox mount -t devtmpfs none /dev
/bin/busybox mount -t devpts devpts /dev/pts  # Нужно для getty/терминалов

stty sane < /dev/tty1
stty -echo < /dev/tty1 2>/dev/null

# устанавливаем окружение
export PATH=/bin:/sbin:/usr/bin:/usr/sbin:$PATH
export HOME=/
export PS1='[wilixos@wilixos \W]\$ '

/bin/busybox hostname wilix # <- черемша

# создаём симлинки на busybox для всех команд 
echo "creating busybox symlinks..."
/bin/busybox --install -s

# генеральная уборка экрана
/bin/busybox clear

# велком ту пиздец
echo "=========================================="
echo "  wilix v0.2 "
echo "=========================================="
echo ""
echo "welcome to linux!"
echo ""
/bin/busybox uname -a
echo ""
bash --version
echo "=========================================="

# запуск всех скриптов
run_init_scripts

sleep 1

echo "=========================================="
echo "init scripts completed. starting shell..."
echo "=========================================="


# запуск шашаш баша
trap '' INT QUIT TSTP

sleep 2


echo "switching to /dev/tty1..."
exec /bin/bash < /dev/tty1 > /dev/tty1 2>&1
EOF

chmod +x init

# создаем директорию для init скриптов
mkdir -p etc/init.d

# создаем скрипт для getty
cat > etc/init.d/S01-getty << 'GETTY'
#!/bin/sh

case "$1" in
    start)
        echo "starting getty on virtual consoles..."
        
        # запускаем getty на тту 2-7
        for tty in tty2 tty3 tty4 tty5 tty6 tty7; do
            if [ -c /dev/$tty ]; then
                /bin/busybox getty -n -l /bin/bash -i 38400 $tty &
            fi
        done
        ;;
    stop)
        echo "stopping getty..."
        killall busybox getty 2>/dev/null
        ;;
    restart)
        $0 stop
        sleep 1
        $0 start
        ;;
    *)
        echo "usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac
GETTY

chmod +x etc/init.d/S01-getty

# создаем вспомогательный скрипт информацию о консолях
cat > etc/init.d/99-consoles << 'CONSOLES'
#!/bin/sh

case "$1" in
    start)
        echo ""
        echo "available consoles:"
        echo "  tty1 (Ctrl+Alt+F1) - getty active"
        echo "  tty2 (Ctrl+Alt+F2) - getty active"
        echo "  tty3 (Ctrl+Alt+F3) - getty active"
        echo "  tty4 (Ctrl+Alt+F4) - getty active"
        echo "  current console - bash shell"
        echo ""
        ;;
esac
CONSOLES

chmod +x etc/init.d/99-consoles

cat > etc/init.d/S03-network << 'EOF'
#!/bin/sh

confirm() {
    printf "enable network? [y,n]: "
    read answer
    case "$answer" in
        y|Y|yes|Yes|YES)
            return 0
            ;;
        *)
            echo "operation cancelled."
            exit 0
            ;;
    esac
}

case "$1" in
    start)
        confirm
        
        echo "starting network..."
        
        # проверка наличия сетевых интерфейсов
        if [ ! -d /sys/class/net/eth0 ]; then
            echo "  eth0 not found, skipping..."
            exit 0
        fi
        
        # поддерживаем интерфейс и поднимаем его
        ip link set eth0 up
        
        # пробуем dhcp
        if command -v udhcpc > /dev/null 2>&1; then
            echo "  starting DHCP client (udhcpc)..."
            udhcpc -i eth0 -n -q &
            sleep 3
        fi
        
        # если dhcp не дал в рот, тоесть айпи ставим статику
        if ! ip addr show eth0 | grep -q "inet "; then
            echo "  dhcp failed, using static IP..."
            ip addr add 10.0.2.15/24 dev eth0
            ip route add default via 10.0.2.2
            echo "nameserver 8.8.8.8" > /etc/resolv.conf
            echo "nameserver 1.1.1.1" >> /etc/resolv.conf
        fi
        
        # выводим айпи
        IP=$(ip addr show eth0 | grep "inet " | awk '{print $2}' | cut -d/ -f1)
        if [ -n "$IP" ]; then
            echo "  network ready! ip: $IP"
        else
            echo "  failed to configure network"
        fi
        ;;
        
    stop)
        confirm
        
        echo "stopping network..."
        # убиваем dhcp клиента вайлдберрис
        killall udhcpc 2>/dev/null
        # Опускаем интерфейс
        ip link set eth0 down
        ;;
        
    restart)
        $0 stop
        sleep 1
        $0 start
        ;;
        
    status)
        # для status подтверждение не требуется
        if ip addr show eth0 | grep -q "inet "; then
            echo "Network is up:"
            ip addr show eth0 | grep "inet "
            ip route show | grep default
        else
            echo "network is down"
        fi
        ;;
        
    *)
        echo "usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac
EOF

chmod +x etc/init.d/S03-network

# создаем пустую директорию для спермы228
touch etc/init.d/.keep

echo "building initrd image with getty support..."
find . | cpio -o -H newc | gzip > ../wilixos-v0.1.img

echo "=========================================="
echo "done! image created: ../wilixos-v0.1.img"
echo ""
echo "features added:"
echo "  - getty running on tty1, tty2, tty3, tty4"
echo "  - switch consoles with Ctrl+Alt+F1..F4"
echo "  - auto-start init scripts from /etc/init.d/"
echo ""
echo "to test in QEMU:"
echo "qemu-system-x86_64 -kernel /boot/vmlinuz -initrd ../wilixos-v0.1.img -append \"root=/dev/ram0\""
echo "=========================================="
