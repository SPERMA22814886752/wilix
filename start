}

static void run_init_scripts(void) {
    struct dirent **namelist;
    int n;

    if (access("/etc/init.d", F_OK) != 0)
        return;

    n = scandir("/etc/init.d", &namelist, NULL, alphasort);
    if (n < 0) {
        fprintf(stderr, "cannot scan /etc/init.d\n");
        return;
    }

    /* первый проход: скрипты, начинающиеся с S, с аргументом "start" */
    for (int i = 0; i < n; i++) {
        if (namelist[i]->d_name[0] == 'S') {
            char path[512];
            snprintf(path, sizeof(path), "/etc/init.d/%s", namelist[i]->d_name);

            /* проверяем, что исполняемый */
            if (access(path, X_OK) != 0)
                continue;

            printf("starting: %s ", namelist[i]->d_name);
            pid_t pid = fork();
            if (pid == 0) {
                execl(path, namelist[i]->d_name, "start", (char *)NULL);
                _exit(1);
            }
            int status;
            waitpid(pid, &status, 0);
            printf("[OK]\n");
        }
    }

    /* второй проход: остальные скрипты, просто запускаем без аргументов */
    for (int i = 0; i < n; i++) {
        if (namelist[i]->d_name[0] != 'S') {
            char path[512];
            snprintf(path, sizeof(path), "/etc/init.d/%s", namelist[i]->d_name);

            if (access(path, X_OK) != 0)
                continue;

            printf("running: %s ", namelist[i]->d_name);
            pid_t pid = fork();
            if (pid == 0) {
                execl(path, namelist[i]->d_name, (char *)NULL);
                _exit(1);
            }
            int status;
            waitpid(pid, &status, 0);
            printf("[OK]\n");
        }
    }

    /* освобождаем память жопа */
    for (int i = 0; i < n; i++)
        free(namelist[i]);
    free(namelist);
    
    /* перемещение gzip */
    pid_t mvpid = fork();
    if (mvpid == 0) {
        execl("/bin/mv", "mv", "/bin/gzip", "/usr/bin/", (char *)NULL);
        _exit(1);
    }
    waitpid(mvpid, NULL, 0);
    printf("[OK]\n");
}

/* запуск оболочки */
static void spawn_shell(void) {
    int fd = open("/dev/tty1", O_RDWR);
    if (fd < 0) {
        fprintf(stderr, "fatal: cannot open /dev/tty1: %s\n", strerror(errno));
        exit(1);
    }

    if (setsid() == -1) {
        perror("setsid");
        exit(1);
    }

    if (ioctl(fd, TIOCSCTTY, 1) == -1) {
        perror("TIOCSCTTY");
    }

    dup2(fd, STDIN_FILENO);
    dup2(fd, STDOUT_FILENO);
    dup2(fd, STDERR_FILENO);
    if (fd > 2)
        close(fd);

    /* используем /bin/login */
    execl("/bin/login", "login", "-p", (char *)NULL);
    execl("/bin/sh", "sh", (char *)NULL);

    fprintf(stderr, "fatal: cannot launch shell\n");
    exit(1);
}

/* утилита для запуска busybox-апплетов */
static int run_busybox(char *const argv[]) {
    pid_t pid = fork();
    if (pid == 0) {
        execv("/bin/busybox", argv);
        _exit(1);
    }
    int status;
    waitpid(pid, &status, 0);
    return WIFEXITED(status) ? WEXITSTATUS(status) : -1;
}
