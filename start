/* игнорируем сигналы int, quit, tstp */
static void ignore_signals(void) {
    signal(SIGINT, SIG_IGN);
    signal(SIGQUIT, SIG_IGN);
    signal(SIGTSTP, SIG_IGN);
    /* не надо прерываться */
    signal(SIGHUP, SIG_IGN);
    signal(SIGPIPE, SIG_IGN);
}

/* обертка для mount(2) */
static int do_mount(const char *source, const char *target,
                    const char *fstype, unsigned long flags, const void *data) {
    if (mount(source, target, fstype, flags, data) != 0) {
        fprintf(stderr, "mount: %s on %s (%s): %s\n",
                source, target, fstype, strerror(errno));
        return -1;
    }
    return 0;
}

/* stty sane и stty -echo на /dev/tty1 через busybox */
static void setup_console(void) {
    pid_t pid;
    int fd;

    fd = open("/dev/tty1", O_RDWR);
    if (fd < 0) {
        fprintf(stderr, "cannot open /dev/tty1: %s\n", strerror(errno));
        return;
    }

    /* stty sane */
    pid = fork();
    if (pid == 0) {
        dup2(fd, STDIN_FILENO);
        dup2(fd, STDOUT_FILENO);
        close(fd);
        execl("/bin/busybox", "busybox", "stty", "sane", (char *)NULL);
        _exit(1);
    }
    waitpid(pid, NULL, 0);

    if (pid == 0) {
        dup2(fd, STDIN_FILENO);
        dup2(fd, STDOUT_FILENO);
        close(fd);
        execl("/bin/busybox", "busybox", "stty", "-echo", (char *)NULL);
        _exit(1);
    }
    waitpid(pid, NULL, 0); 

    close(fd);
}

/* установка окружения */
static void set_env(void) {
    setenv("PATH", "/bin:/sbin:/usr/bin:/usr/sbin", 1);
    setenv("HOME", "/", 1);
    setenv("PS1", "[\\u@\\h \\W]$ ", 1);
    setenv("SSL_CERT_FILE", "/etc/ssl/certs/ca-certificates.crt", 1);
}

/* установка имени хоста */
static void set_hostname(void) {
    if (sethostname("wilix", 5) != 0) {
        fprintf(stderr, "sethostname failed: %s\n", strerror(errno));
    }
}

/* запуск busybox --install -s */
static void install_busybox_symlinks(void) {
    char *const args[] = { "/bin/busybox", "busybox", "--install", "-s", NULL };
    run_busybox(args);
}

/* загрузка модулей из /lib/modules если есть*/
static void load_kernel_modules(void) {
    DIR *dir;
    struct dirent *ent;
    char path[4096];
    char modname[256];
    struct stat st;

    /* проверяем существование директории */
    if (stat("/lib/modules", &st) != 0 || !S_ISDIR(st.st_mode))
        return;

    dir = opendir("/lib/modules");
    if (!dir) return;

    /* проход по файлам /lib/modules/ */
    while ((ent = readdir(dir)) != NULL) {
        /* нужны только файлы с расширением .ko */
        char *dot = strrchr(ent->d_name, '.');
        if (!dot || strcmp(dot, ".ko") != 0)
            continue;

        /* полный путь к модулю */
        snprintf(path, sizeof(path), "/lib/modules/%s", ent->d_name);
        /* базовое имя без .ko */
        strncpy(modname, ent->d_name, dot - ent->d_name);
        modname[dot - ent->d_name] = '\0';

        /* запускаем modprobe */
        pid_t pid = fork();
        if (pid == 0) {
            execl("/bin/busybox", "busybox", "modprobe", modname, (char *)NULL);
            _exit(1);
        }
        waitpid(pid, NULL, 0);
    }
    closedir(dir);
}

/* генеральная очистка */
static void clear_screen(void) {
    char *const args[] = { "/bin/busybox", "busybox", "clear", NULL };
    run_busybox(args);
