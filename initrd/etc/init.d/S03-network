#!/bin/sh
confirm() {
printf "enable network? [y,n]: "
read answer
case "$answer" in
y|Y|yes|Yes|YES)
return 0
            ;;
*)
echo "operation cancelled."
exit 0
            ;;
esac
}

# определяем виртуалка ли это
is_virtual() {
    # проверяем наличие virtio, hyperv и т.д.
    if grep -qi "hypervisor\|kvm\|virtualbox\|xen" /proc/cpuinfo; then
        return 0
    fi
    if [ -d /sys/hypervisor ]; then
        return 0
    fi
    return 1
}

case "$1" in
start)
confirm
echo "starting network..."
if [ ! -d /sys/class/net/eth0 ]; then
echo "  eth0 not found, skipping..."
exit 0
fi

ip link set eth0 up

# определяем IP в зависимости от железа
if is_virtual; then
    echo "  virtual machine detected, using 10.x.x.x"
    ip addr add 10.0.2.15/24 dev eth0
    ip route add default via 10.0.2.2
else
    echo "  real hardware detected, using 192.168.x.x"
    ip addr add 192.168.1.100/24 dev eth0
    ip route add default via 192.168.1.1
fi

echo "nameserver 8.8.8.8" > /etc/resolv.conf
echo "nameserver 1.1.1.1" >> /etc/resolv.conf

IP=$(ip addr show eth0 | grep "inet " | awk '{print $2}' | cut -d/ -f1)
if [ -n "$IP" ]; then
    echo "  network ready! ip: $IP"
else
    echo "  failed to configure network"
fi
        ;;
stop)
confirm
echo "stopping network..."
killall udhcpc 2>/dev/null
ip link set eth0 down
        ;;
restart)
$0 stop
sleep 1
$0 start
        ;;
status)
if ip addr show eth0 | grep -q "inet "; then
    echo "Network is up:"
    ip addr show eth0 | grep "inet "
    ip route show | grep default
else
    echo "network is down"
fi
        ;;
*)
echo "usage: $0 {start|stop|restart|status}"
exit 1
        ;;
esac
